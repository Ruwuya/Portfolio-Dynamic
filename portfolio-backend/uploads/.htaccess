# Uploaded files are only ever downloaded, never run as code
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|phar|php\d?|pht|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar

Options -Indexes -ExecCGI
